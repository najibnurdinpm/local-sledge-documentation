{
  "name": "sledge-documentation",
  "version": "0.0.1",
  "description": "Sledge Documentation",
  "scripts": {
    "dev": "run-p dev:*",
    "dev:next": "next dev",
    "dev:css": "npm run generate:css -- --watch",
    "build": "npm run build:css && npm run build:next",
    "build:css": "npm run generate:css -- --minify",
    "build:next": "next build",
    "generate:css": "tailwindcss -i ./styles/style.css -o ./styles/tailwind.css",
    "start": "next start -p 3001"
  },
  "license": "MIT",
  "dependencies": {
    "framer-motion": "^10.16.1",
    "next": "^13.0.6",
    "nextra": "^2.13.4",
    "nextra-theme-docs": "^2.13.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.32.6",
    "swr": "^2.2.4"
  },
  "devDependencies": {
    "@types/node": "18.11.10",
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "autoprefixer": "^10.4.14",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.26",
    "tailwindcss": "^3.3.3",
    "typescript": "^5.1.6"
  },
  "resolutions": {
    "flexsearch": "0.7.31"
  }
}